# Optional. With a Porkbun API key, handle-scout confirms available domains with a
# registrar and shows their price. Without it, everything still works using the free
# registry lookups. See "Porkbun API key" in the README for how to create the key.
#
# Copy this file to .env (same folder) and fill in both values.
# .env is ignored by git. Never commit real keys.

PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=
